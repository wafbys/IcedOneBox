<Window
    x:Class="OneBox.Shell.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="IcedOneBox">
    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Padding="24"
        Spacing="12">
        <Button
            x:Name="InitButton"
            Content="初始化核并生成 ID"
            Click="InitButton_Click" />
        <TextBlock
            x:Name="ResultText"
            Text="尚未初始化"
            TextWrapping="Wrap" />
    </StackPanel>
</Window>
