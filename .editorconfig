# EditorConfig for IcedOneBox

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{toml,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{c,h}]
indent_size = 4

# Windows PowerShell 5.1 按系统代码页解析 .ps1；含中文的脚本必须带 BOM，
# 才能在 5.1 与 PowerShell 7 下都被正确解析。
[*.ps1]
charset = utf-8-bom
