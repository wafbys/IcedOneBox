<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>csharp-smoke</AssemblyName>
    <RootNamespace>IcedOneBox.Smoke</RootNamespace>
    <!-- 需要加载核 DLL：由仓库根 Directory.Build.targets 复制 onebox.dll 到输出目录。 -->
    <CopyOneBoxNative>true</CopyOneBoxNative>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\csharp\OneBox.Interop\OneBox.Interop.csproj" />
  </ItemGroup>

</Project>
