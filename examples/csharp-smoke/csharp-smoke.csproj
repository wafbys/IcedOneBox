<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- [LibraryImport] 源生成的编组代码需要 unsafe。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>csharp-smoke</AssemblyName>
    <RootNamespace>IcedOneBox.Smoke</RootNamespace>
  </PropertyGroup>

  <!-- 把 Rust 核产物 onebox.dll 复制到输出目录，供 [LibraryImport] 加载。 -->
  <Target Name="CopyOneboxNative" AfterTargets="Build">
    <PropertyGroup>
      <OneboxProfile Condition="'$(Configuration)' == 'Release'">release</OneboxProfile>
      <OneboxProfile Condition="'$(Configuration)' != 'Release'">debug</OneboxProfile>
      <OneboxNative>$(MSBuildThisFileDirectory)..\..\target\$(OneboxProfile)\onebox.dll</OneboxNative>
    </PropertyGroup>
    <Error Condition="!Exists('$(OneboxNative)')"
           Text="未找到 $(OneboxNative)。请先在仓库根执行 cargo build（Release 配置需 cargo build --release）。" />
    <Copy SourceFiles="$(OneboxNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
